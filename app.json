{
  "expo": {
    "name": "OnyxAI",
    "slug": "onyxai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "onyxai",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.anxbt.onyxai",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
