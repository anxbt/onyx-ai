# Local Development Environment Variables for Postman Testing
# Copy to .env.local and fill in with values from supabase start output

# Supabase Local Setup
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Worker Local Setup
WORKER_URL=http://localhost:8787

# Test User (Create via Supabase Studio at http://localhost:54321)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123456
TEST_USER_ID=
TEST_JWT_TOKEN=

# API Keys (Required for Worker)
OPENROUTER_API_KEY=your-key-here
RAZORPAY_KEY_ID=your-key-here
RAZORPAY_KEY_SECRET=your-key-here
OPENAI_API_KEY=your-key-here
